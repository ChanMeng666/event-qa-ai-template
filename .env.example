# =============================================================================
# Aotearoa AI Hackathon Festival 2026 - Voice AI Agent
# Environment configuration
# =============================================================================
#
# Copy this file to .env.local and fill in your values.
# On Vercel, add these in Project Settings -> Environment Variables, or let the
# Vercel Postgres / KV integrations inject the storage vars automatically.
#
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (Required) - powers both text chat and the Realtime voice agent
# -----------------------------------------------------------------------------
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Vercel Postgres / Neon (Optional but recommended)
# -----------------------------------------------------------------------------
# Injected automatically by the Vercel Postgres (Neon) integration. If unset,
# the app falls back to the static knowledge in config/ and skips transcript
# persistence. One of the following connection strings is used:
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# -----------------------------------------------------------------------------
# Vercel KV / Upstash Redis (Optional) - rate limiting for the voice/chat APIs
# -----------------------------------------------------------------------------
# Injected automatically by the Vercel KV (Upstash) integration. If unset,
# rate limiting is disabled (allow-all).
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_api_token
# (Alternatively: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
