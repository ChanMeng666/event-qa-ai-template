# =============================================================================
# Aotearoa AI Hackathon Festival 2026 - Voice AI Agent
# Environment configuration
# =============================================================================
#
# Copy this file to .env.local and fill in your values.
# On Vercel, add these in Project Settings -> Environment Variables, or let the
# Vercel Postgres / KV integrations inject the storage vars automatically.
#
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (Required) - powers both text chat and the Realtime voice agent
# -----------------------------------------------------------------------------
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Vercel Postgres / Neon (Optional but recommended)
# -----------------------------------------------------------------------------
# Injected automatically by the Vercel Postgres (Neon) integration. If unset,
# the app falls back to the static knowledge in config/ and skips transcript
# persistence. One of the following connection strings is used:
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# -----------------------------------------------------------------------------
# Vercel KV / Upstash Redis (Recommended for production)
# -----------------------------------------------------------------------------
# Required for rate limiting, turn quotas, and token budget circuit breakers.
# If unset, all limits are disabled (allow-all) for local dev convenience.
#
# Vercel setup:
#   1. Project -> Storage -> Create Database -> KV (Upstash Redis)
#   2. Connect to this project (auto-injects KV_REST_API_URL + KV_REST_API_TOKEN)
#   3. Redeploy
#
# Local: vercel env pull .env.local
#
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your_kv_rest_api_token
# (Alternatively: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# -----------------------------------------------------------------------------
# Rate limits & token budgets (Optional overrides)
# -----------------------------------------------------------------------------
# Defaults live in config/limits.config.ts. Override without code changes:
#
# LIMITS_API_BURST_PER_MINUTE=30
# LIMITS_REALTIME_SESSIONS_PER_MINUTE=5
# LIMITS_REALTIME_SESSIONS_PER_HOUR=20
# LIMITS_REALTIME_SESSIONS_PER_DAY=50
# LIMITS_REALTIME_MAX_SESSION_MINUTES=15
# LIMITS_REALTIME_MAX_TURNS_PER_SESSION=30
# LIMITS_REALTIME_MAX_TURNS_PER_DAY=100
# LIMITS_REALTIME_MAX_TEXT_LENGTH=500
# LIMITS_REALTIME_RECONNECT_COOLDOWN=30
# LIMITS_REALTIME_TEXT_MIN_INTERVAL_MS=2000
# LIMITS_TRANSCRIPT_PER_MINUTE=120
# LIMITS_DAILY_TOKEN_BUDGET=500000
# LIMITS_PER_CLIENT_DAILY_TOKEN_BUDGET=30000
# LIMITS_CHAT_MESSAGES_PER_MINUTE=20
# LIMITS_CHAT_MESSAGES_PER_HOUR=60
# LIMITS_CHAT_MESSAGES_PER_DAY=200

# -----------------------------------------------------------------------------
# Chat API (Optional)
# -----------------------------------------------------------------------------
# The live UI uses Realtime for typed input. /api/chat is disabled by default.
# Set to true only if you wire a separate text chat client.
# ENABLE_CHAT_API=false
